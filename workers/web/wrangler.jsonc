// americawhat-web: public site (Static Assets) + public API.
// The top level is STAGING. Production is env.production and can only be
// deployed with `--env production` after its D1 ids replace the placeholders,
// through the owner-approved release procedure (docs/RELEASE-RUNBOOK.md).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "americawhat-web-staging",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Staging runs the Worker first on every request so it can add noindex.
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "APP_DB", "database_name": "americawhat-app-staging", "database_id": "REPLACE_WITH_STAGING_APP_DB_ID", "migrations_dir": "../../migrations/app" },
    { "binding": "ANALYTICS_DB", "database_name": "americawhat-analytics-staging", "database_id": "REPLACE_WITH_STAGING_ANALYTICS_DB_ID", "migrations_dir": "../../migrations/analytics" }
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "SITE_HOSTNAME": "americawhat-web-staging.workers.dev",
    "PUBLIC_ORIGINS": "REPLACE_WITH_STAGING_WORKERS_DEV_ORIGIN"
  },
  "observability": { "enabled": true },
  "env": {
    "production": {
      "name": "americawhat-web-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "americawhat.com", "custom_domain": true },
        { "pattern": "www.americawhat.com", "custom_domain": true }
      ],
      "assets": {
        "directory": "../../dist",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page",
        // The Worker runs first so trailing-slash redirects stay 301 (as on Apache).
        "run_worker_first": true
      },
      "d1_databases": [
        { "binding": "APP_DB", "database_name": "americawhat-app-production", "database_id": "PRODUCTION_NOT_PROVISIONED", "migrations_dir": "../../migrations/app" },
        { "binding": "ANALYTICS_DB", "database_name": "americawhat-analytics-production", "database_id": "PRODUCTION_NOT_PROVISIONED", "migrations_dir": "../../migrations/analytics" }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "SITE_HOSTNAME": "americawhat.com",
        "PUBLIC_ORIGINS": "https://americawhat.com,https://www.americawhat.com"
      },
      "observability": { "enabled": true }
    }
  }
}
