// americawhat-web: public site (Static Assets) + public API.
// The top level is STAGING. Production is env.production: its D1 ids are
// placeholders until provisioning (docs/PRODUCTION-PROVISIONING.md), and
// `node scripts/release/cf-release.mjs check-config production` refuses it until then.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "americawhat-web-staging",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Staging runs the Worker first on every request so it can add noindex.
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "APP_DB", "database_name": "americawhat-app-staging", "database_id": "a3c9ff1f-05c2-4ed6-bb9e-4ca41f4cc9e2", "migrations_dir": "../../migrations/app" },
    { "binding": "ANALYTICS_DB", "database_name": "americawhat-analytics-staging", "database_id": "306b9ee6-2529-4f95-b43c-c7cd9dbf0a3c", "migrations_dir": "../../migrations/analytics" }
  ],
  "vars": {
    "ENVIRONMENT": "staging",
    "SITE_HOSTNAME": "americawhat-web-staging.hakan-c89.workers.dev",
    "PUBLIC_ORIGINS": "https://americawhat-web-staging.hakan-c89.workers.dev"
  },
  "observability": { "enabled": true },
  "env": {
    "production": {
      "name": "americawhat-web-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "americawhat.com", "custom_domain": true },
        { "pattern": "www.americawhat.com", "custom_domain": true }
      ],
      "assets": {
        "directory": "../../dist",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page",
        // The Worker runs first so trailing-slash redirects stay 301 (as on Apache).
        "run_worker_first": true
      },
      "d1_databases": [
        { "binding": "APP_DB", "database_name": "americawhat-app-production", "database_id": "PRODUCTION_NOT_PROVISIONED", "migrations_dir": "../../migrations/app" },
        { "binding": "ANALYTICS_DB", "database_name": "americawhat-analytics-production", "database_id": "PRODUCTION_NOT_PROVISIONED", "migrations_dir": "../../migrations/analytics" }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "SITE_HOSTNAME": "americawhat.com",
        "PUBLIC_ORIGINS": "https://americawhat.com,https://www.americawhat.com"
      },
      // Workers Paid: an explicit ceiling far above the measured cost of any
      // public request (edge Trending is one D1 read), so a runaway request
      // fails fast instead of running up to the 30 s default.
      "limits": { "cpu_ms": 1000 },
      "observability": { "enabled": true }
    }
  }
}
