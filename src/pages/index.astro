---
import Base from "../layouts/Base.astro";
import Feed from "../components/Feed.astro";
import CategoryChips from "../components/CategoryChips.astro";
import { FEED_PAGE_SIZE, newest as items } from "../lib/feed.js";

const lastPage = Math.max(1, Math.ceil(items.length / FEED_PAGE_SIZE));
const trendingStories = items.map((item) => ({ id: item.id, title: item.title, href: `/item/${item.slug}/` }));
---
<Base
  title="americawhat — weird, funny, deeply American news"
  description="A curated feed of absurd, funny, deeply American moments — real stories, sourced and dryly captioned. HOA fines, Florida man, fine print, and more. Wait, what."
  canonicalPath="/"
>
  <section class="hero" aria-label="americawhat" slot="hero">
    <div class="hero-inner">
      <div class="hero-eyebrow">A running feed of the deeply American</div>
      <h1 class="hero-title">
        <span class="hero-america">America,</span>
        <span class="hero-second"><span class="hero-word">what</span><span class="hero-q">?</span></span>
      </h1>
      <p class="hero-lede">The strange, the everyday, the unbelievably American. The moments that make you stop and go <em>wait, what.</em></p>
    </div>
  </section>

  <section class="trending" id="trending" hidden>
    <div class="trending-head"><span class="trending-flag">Trending</span> — most-reacted right now</div>
    <ol class="trending-list" id="trending-list"></ol>
  </section>

  <CategoryChips />
  <Feed items={items.slice(0, FEED_PAGE_SIZE)} lastPage={lastPage} />

  <script id="trending-stories" type="application/json" set:html={JSON.stringify(trendingStories).replace(/</g, "\u003c")} />

  <script>
    // ── Trending: top-5 by total reactions (client-side, live) ──
    (async function () {
      const stories = JSON.parse(document.getElementById("trending-stories")?.textContent || "[]");
      if (!stories.length) return;
      const ids = stories.map((story) => story.id);
      let data = {};
      try {
        const res = await fetch("/analytics/get_votes.php?ids=" + ids.join(","));
        data = await res.json();
      } catch (e) {
        return;
      }
      const esc = (s) =>
        String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
      const rows = [];
      stories.forEach((story) => {
        const id = story.id;
        const counts = (data && data[id]) || {};
        const total = Object.values(counts).reduce((a, b) => a + (parseInt(b, 10) || 0), 0);
        rows.push({ title: story.title, href: story.href, total });
      });
      const top = rows.filter((r) => r.total > 0).sort((a, b) => b.total - a.total).slice(0, 5);
      if (top.length < 3) return; // stay hidden until there's real signal
      const ol = document.getElementById("trending-list");
      const sec = document.getElementById("trending");
      if (!ol || !sec) return;
      ol.innerHTML = top
        .map(
          (r, i) =>
            `<li><a href="${esc(r.href)}"><span class="trending-rank">${i + 1}</span><span class="trending-title">${esc(r.title)}</span><span class="trending-count">${r.total}</span></a></li>`
        )
        .join("");
      sec.hidden = false;
    })();
  </script>

  <script src="../scripts/tracking.js"></script>
</Base>
