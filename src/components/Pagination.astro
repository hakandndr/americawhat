---
// Numbered pagination for statically generated listing pages.
// `href(n)` returns the URL of page n; page 1 is the listing's root URL.
const { current, last, href, label = "Pages" } = Astro.props;
const shown = [...new Set([1, current - 1, current, current + 1, last])]
  .filter((n) => n >= 1 && n <= last)
  .sort((a, b) => a - b);
const parts = [];
shown.forEach((n, i) => {
  if (i && n - shown[i - 1] > 1) parts.push({ gap: true, key: `g${n}` });
  parts.push({ n, key: `p${n}` });
});
---
{last > 1 && (
  <nav class="pager" aria-label={label}>
    {current > 1
      ? <a class="pager-step" href={href(current - 1)} rel="prev">← Newer</a>
      : <span class="pager-step is-off" aria-hidden="true">← Newer</span>}
    <ol class="pager-list">
      {parts.map((p) => p.gap
        ? <li class="pager-gap" aria-hidden="true">…</li>
        : <li>{p.n === current
            ? <span class="pager-num is-on" aria-current="page">{p.n}</span>
            : <a class="pager-num" href={href(p.n)} aria-label={`Page ${p.n}`}>{p.n}</a>}</li>)}
    </ol>
    {current < last
      ? <a class="pager-step" href={href(current + 1)} rel="next">Older →</a>
      : <span class="pager-step is-off" aria-hidden="true">Older →</span>}
  </nav>
)}
